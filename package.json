{
  "name": "jwebgen",
  "version": "2.2.0",
  "description": "CLI generator for Java web projects (Servlet/JSP).",
  "type": "module",
  "bin": {
    "jwebgen": "bin/jwebgen.js"
  },
  "files": [
    "bin",
    "src",
    "tests",
    "README.md",
    "TROUBLESHOOTING.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test": "npm run test:unit && bash ./tests/golden-check.sh && bash ./tests/integration/template-asserts.sh && bash ./tests/integration/run-matrix.sh",
    "check:syntax": "bash ./tests/check-syntax.sh",
    "lint": "eslint .",
    "check": "npm run check:syntax && npm run lint && npm run test",
    "release:verify": "npm pack --dry-run >/dev/null && npm run check"
  },
  "engines": {
    "node": ">=18.19.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "chokidar": "^3.6.0",
    "execa": "^9.6.1",
    "picocolors": "^1.1.1",
    "ws": "^8.18.0"
  },
  "keywords": [
    "java",
    "servlet",
    "jsp",
    "generator",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "globals": "^17.5.0"
  }
}
