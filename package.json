{
  "name": "jwebgen",
  "version": "2.2.1",
  "description": "CLI to scaffold Jakarta Servlet/JSP apps with build, deploy, and dev scripts.",
  "type": "module",
  "bin": {
    "jwebgen": "bin/jwebgen.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "TROUBLESHOOTING.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "test:unit": "node tests/run-unit.mjs",
    "test": "npm run test:unit && bash ./tests/golden-check.sh && bash ./tests/integration/template-asserts.sh && bash ./tests/integration/run-matrix.sh",
    "check:syntax": "bash ./tests/check-syntax.sh",
    "check:wording": "bash ./tests/check-wording.sh",
    "lint": "eslint .",
    "smoke:generated": "bash ./tests/smoke-generated-project.sh",
    "smoke:global-install": "node tests/install-global-smoke.mjs",
    "check": "npm run check:syntax && npm run check:wording && npm run lint && npm run test",
    "release:verify": "npm pack --dry-run >/dev/null && npm run check"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "chokidar": "^3.6.0",
    "execa": "^9.6.1",
    "picocolors": "^1.1.1",
    "ws": "^8.18.0"
  },
  "keywords": [
    "java",
    "servlet",
    "jsp",
    "generator",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "globals": "^17.5.0"
  }
}
